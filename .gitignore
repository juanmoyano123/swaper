# Secretos — nunca versionar
.env
credentials.json
token.json

# Configuración local del agente
.claude/settings.local.json

# Outputs regenerables: una cartera, un swap o un log por corrida
data/output/*

# ...salvo estos dos, que no siempre se pueden regenerar. El universo carga
# condiciones que ya no tienen CSV de origen, y el cashflow depende de un token
# de Docta que vence. Ya perdimos datos una vez por dar por sentado que un
# archivo se regeneraba solo.
!data/output/universo_consolidado.xlsx
!data/output/cashflow_completo.csv

# Basura de macOS
.DS_Store

# Frontend
frontend/node_modules/
frontend/dist/

# Backend
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc

# El motor: lo importa el test del GWT-4, que verifica que sigue leyendo el universo consolidado
tools/__pycache__/

# Worktrees temporales de los agentes
.claude/worktrees/
