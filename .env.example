# Copiar a .env y completar. .env nunca se versiona (ver .gitignore).

# Supabase — obligatorias: el backend no arranca si falta o esta vacia alguna de estas.
# URL y anon key salen del dashboard (Settings -> API). La service role key nunca se expone
# al frontend. DATABASE_URL usa el Session pooler (puerto 5432), que es compatible con IPv4.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# No hay JWT secret que cargar: Supabase firma con ES256 y el backend verifica contra el JWKS
# publico del proyecto, que baja solo. La variable existio hasta el 07/08/2026 y se elimino.

# Frontend (Vite) — mismos valores que SUPABASE_URL/SUPABASE_ANON_KEY de arriba, pero con el
# prefijo VITE_ que exige Vite para exponerlos al bundle del navegador. La anon key esta pensada
# para viajar al cliente -el aislamiento real lo aplica RLS en la base, no el secreto de esta key-
# asi que no es una credencial nueva, es la misma con otro nombre. Obligatorias desde F-014.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# BYMA — API abierta, sin token: no hay credencial que cargar. Se declaran para poder apuntar a
# otro host o corregir la demora sin tocar codigo. Tienen default, no hace falta completarlas.
# BYMA_BASE_URL=https://open.bymadata.com.ar/vanoms-be-core/rest/api/bymadata/free
# BYMA_DEMORA_MINUTOS=20

# Serie historica de precios y puntas. En false (el default) cada corrida deja UNA fila por ticker:
# la mas reciente. En true se acumula un snapshot por corrida y la serie intradiaria queda
# reconstruible, a costa de ~11 MB por dia habil que nada borra.
#
# Ojo: esto NO es INGESTA_HABILITADA. Los precios se actualizan igual cada 20 minutos; lo que esta
# variable prende o apaga es la acumulacion, no la ingesta.
# SERIE_HISTORICA_HABILITADA=false

# CRON_SECRET — la credencial con la que un cron externo dispara los jobs de ingesta
# (POST /api/v1/jobs/* y POST /api/v1/consolidar). Se manda como `Authorization: Bearer <valor>`.
# Generar una cadena larga y al azar, por ejemplo con `openssl rand -hex 32`.
#
# Es OPCIONAL y su ausencia CIERRA, no abre: sin esta variable el camino del cron queda
# deshabilitado por completo y esos endpoints sólo se abren con sesión de asesor (el JWT que manda
# el frontend logueado). Por eso no tiene default: cualquier valor inventado sería un secreto
# conocido, y un deploy al que se le olvidó la variable tiene que quedar cerrado, no abierto.
# CRON_SECRET=

# INGESTA_HABILITADA — prende el scheduler que vive DENTRO del proceso del backend. Sirve con
# uvicorn o Docker, donde hay un proceso de larga vida. **En Vercel tiene que quedar en false**:
# una funcion serverless muere entre requests, asi que el loop no sobrevive y, si hubiera varias
# instancias, cada una correria su propia copia. Alla la ingesta la dispara el cron externo
# (.github/workflows/ingesta.yml) contra GET /api/v1/jobs/cron/*.
# INGESTA_HABILITADA=false

# CAFCI_HABILITADO — la planilla diaria de fondos comunes (api.pub.cafci.org.ar). Sin esto el
# segmento FCI del monitor queda vacio aunque la feature este entera.
# CAFCI_HABILITADO=false

# CNV_HABILITADO — la busqueda de prospectos de ON en el sitio de la CNV. Apagado por default.
# CNV_HABILITADO=false

# Operativas — tienen default, se sobrescriben solo si hace falta.
# LOG_LEVEL=INFO
# ENVIRONMENT=development

# CORS — origenes permitidos a llamar al backend, separados por coma. El default ya trae el
# navegador local y los dos dominios desplegados; se sobreescribe si aparece uno nuevo. En Vercel
# no se ejercita: frontend y backend comparten host, asi que las llamadas son same-origin.
# CORS_ORIGINS=http://localhost:5173,https://swaper-snowy.vercel.app,https://swappt.netlify.app

# Frontend (Vite) — URL publica del backend. **Vacia es lo correcto en Vercel**: el frontend
# pide a rutas relativas (/api/v1/...) y el rewrite de vercel.json las manda al backend en el
# mismo dominio. Solo se completa si el backend pasa a vivir en otro host, y en ese caso hay que
# agregar el dominio del frontend a CORS_ORIGINS.
VITE_API_URL=
