# Copiar a .env y completar. .env nunca se versiona (ver .gitignore).

# Supabase — obligatorias: el backend no arranca si falta o esta vacia alguna de estas.
# URL y anon key salen del dashboard (Settings -> API). La service role key nunca se expone
# al frontend. DATABASE_URL usa el Session pooler (puerto 5432), que es compatible con IPv4.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Docta — feed de cronograma de pagos (cashflow_completo.csv).
# Opcionales hasta F-006, que es la feature que las consume.
DOCTA_API_TOKEN=
DOCTA_CASHFLOW_URL=
DOCTA_YIELD_BONDS_URL=
DOCTA_SERIE_PRECIOS_URL=

# BYMA — API abierta, sin token: no hay credencial que cargar. Se declaran para poder apuntar a
# otro host o corregir la demora sin tocar codigo. Tienen default, no hace falta completarlas.
# BYMA_BASE_URL=https://open.bymadata.com.ar/vanoms-be-core/rest/api/bymadata/free
# BYMA_DEMORA_MINUTOS=20

# IAMC — el informe diario se sube a mano; esta es la carpeta donde se guardan los subidos.
# IAMC_DIRECTORIO=fuentes

# Operativas — tienen default, se sobrescriben solo si hace falta.
# LOG_LEVEL=INFO
# ENVIRONMENT=development
