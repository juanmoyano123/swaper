{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Alias @/ → src/, en espejo con resolve.alias de vite.config.ts.
       Sin `baseUrl`: está deprecado desde TypeScript 6 y los paths relativos ya se resuelven
       contra la ubicación de este archivo. */
    "paths": { "@/*": ["./src/*"] },

    /* Linting. `strict` se enciende acá, con cuatro archivos en el proyecto: activarlo más
       adelante, con cuarenta features encima, sería una migración en vez de una línea. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
